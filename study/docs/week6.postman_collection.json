{
  "info": {
    "name": "UMC 6주차 회원가입·평점 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    },
    {
      "key": "signupEmail",
      "value": ""
    },
    {
      "key": "signupNickname",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 회원가입 성공",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{signupNickname}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.test(\"비밀번호 제외\", () => pm.expect(data.result).not.to.have.property(\"password\"));",
              "pm.collectionVariables.set(\"memberId\", data.result.memberId);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now();",
              "pm.collectionVariables.set(\"signupEmail\", `postman-${runId}@example.com`);",
              "pm.collectionVariables.set(\"signupNickname\", \"회원\" + String(runId).slice(-8));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 입력 검증 실패",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"invalid\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"검증실패\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 이메일 중복",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"중복검사\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"이메일 오류 코드\", () => pm.expect(pm.response.json().code).to.eql(\"MEMBER4091\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 닉네임 중복",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"other-{{signupEmail}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{signupNickname}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"닉네임 오류 코드\", () => pm.expect(pm.response.json().code).to.eql(\"MEMBER4092\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 평점 등록",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 550,\n  \"score\": 5,\n  \"comment\": \"처음 후기\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"ratingId\", pm.response.json().result);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 중복 평점",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 550,\n  \"score\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 별점 범위 실패",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 155,\n  \"score\": 6\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 다른 회원의 수정 차단",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/1/ratings/{{ratingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 다른 회원의 삭제 차단",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/members/1/ratings/{{ratingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 없는 회원",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/999999999/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 550,\n  \"score\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 평점 수정",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 3,\n  \"comment\": \"수정 후기\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 수정 후 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"수정 반영\", () => pm.expect(pm.response.json()[0].score).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 평점 삭제",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"응답 본문 없음\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 삭제 후 빈 목록",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"빈 목록\", () => pm.expect(pm.response.json()).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 없는 평점",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
