{
  "info": {
    "name": "UMC 7주차 - JWT 인증·인가 미션",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "필수 시나리오를 위에서부터 실행하세요. 첫 회원가입 요청이 실행별 계정 변수를 만들고 로그인/등록 응답에서 토큰과 ratingId를 자동 저장합니다. 실습용 H2 서버: http://localhost:8080. 실제 Postman UI 실행 및 캡처는 사용자가 진행합니다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "password",
      "value": "Umc!1234"
    },
    {
      "key": "emailA",
      "value": ""
    },
    {
      "key": "emailB",
      "value": ""
    },
    {
      "key": "nicknameA",
      "value": ""
    },
    {
      "key": "nicknameB",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "tokenTampered",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    },
    {
      "key": "memberA",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. 필수 미션 - 본문 9단계",
      "item": [
        {
          "name": "01-A 회원가입 (실행 변수 초기화)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\",\n  \"nickname\": \"{{nicknameA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString();",
                  "pm.collectionVariables.set('emailA', 'a+' + id + '@umc.com');",
                  "pm.collectionVariables.set('emailB', 'b+' + id + '@umc.com');",
                  "pm.collectionVariables.set('nicknameA', 'A' + id.slice(-9));",
                  "pm.collectionVariables.set('nicknameB', 'B' + id.slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('code: COMMON201', () => pm.expect(pm.response.json().code).to.eql('COMMON201'));",
                  "pm.collectionVariables.set('memberA', pm.response.json().result.memberId);"
                ]
              }
            }
          ]
        },
        {
          "name": "01-B 회원가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailB}}\",\n  \"password\": \"{{password}}\",\n  \"nickname\": \"{{nicknameB}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('code: COMMON201', () => pm.expect(pm.response.json().code).to.eql('COMMON201'));"
                ]
              }
            }
          ]
        },
        {
          "name": "02-A 로그인 [캡처: A 로그인 응답]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code: COMMON200', () => pm.expect(pm.response.json().code).to.eql('COMMON200'));",
                  "pm.collectionVariables.set('tokenA', pm.response.json().result.accessToken);",
                  "const t = pm.response.json().result.accessToken;",
                  "const i = t.indexOf('.') + 10;",
                  "pm.collectionVariables.set('tokenTampered', t.slice(0,i) + (t[i] === 'A' ? 'B' : 'A') + t.slice(i+1));"
                ]
              }
            }
          ]
        },
        {
          "name": "02-B 로그인",
